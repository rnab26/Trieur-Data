# Fichiers generes a l'execution (ne pas committer)
user_master_columns.json
saved_filters.json
export_presets.json
remembered_mappings.json

__pycache__/
*.pyc
.pytest_cache/

# Outils locaux (mais PAS .claude/hooks/ ni settings.json : versionnes
# expres pour que le hook de demarrage Cockpit s'applique a toute
# nouvelle session sur ce depot, voir PROJECT_LOG.md)
.claude/*
!.claude/hooks/
!.claude/hooks/**
!.claude/settings.json

# Secrets Streamlit (clés Supabase) — jamais versionnés
.streamlit/secrets.toml

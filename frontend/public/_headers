# Sans ça, le navigateur peut garder en cache une ancienne version de
# index.html (ex. Chrome mobile) -- il continue alors à réclamer les
# anciens fichiers JS/CSS hashés d'un build précédent, qui n'existent
# plus une fois le site redéployé (un nouvel onglet peut donc "manquer",
# une fonctionnalité récente ne pas apparaître, etc.), sans qu'aucune
# action manuelle (vider le cache) ne soit nécessaire côté utilisateur --
# signalé par Raphaël, 2026-09-22 : "un site qui marche n'a pas à
# demander ça". Format Netlify-style, supporté par Render pour les sites
# statiques.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Les fichiers dans /assets/ sont hashés par Vite (le nom change à
# chaque contenu différent) -- peuvent donc être mis en cache
# indéfiniment sans jamais servir une version périmée.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
